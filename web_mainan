<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Truth or Dare: Versi Pasangan ❤️</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: "Poppins", sans-serif;
      }
      body {
        background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        overflow: hidden;
        position: relative;
      }
      /* Canvas Background Animasi Hati */
      #bg-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 1;
      }
      .card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(5px);
        width: 100%;
        max-width: 420px;
        padding: 30px;
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        text-align: center;
        position: relative;
        z-index: 2;
      }
      h1 {
        color: #c53030;
        font-size: 1.4rem;
        margin-bottom: 5px;
      }
      p.subtitle {
        color: #718096;
        font-size: 0.85rem;
        margin-bottom: 25px;
      }
      .mode-selection {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
      }
      .btn-mode {
        flex: 1;
        padding: 15px;
        border: none;
        border-radius: 16px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        color: white;
        transition:
          transform 0.2s,
          box-shadow 0.2s;
      }
      .btn-truth {
        background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
        box-shadow: 0 4px 15px rgba(253, 160, 133, 0.4);
      }
      .btn-dare {
        background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
        box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
      }
      .btn-mode:hover {
        transform: translateY(-3px);
      }
      .card-content {
        background: #fff5f7;
        border: 2px dashed #fed7e2;
        padding: 25px 20px;
        border-radius: 16px;
        min-height: 140px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        margin-bottom: 20px;
      }
      .card-content h3 {
        font-size: 1.15rem;
        color: #702459;
        line-height: 1.5;
      }
      .badge {
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        padding: 4px 10px;
        border-radius: 20px;
      }
      .badge-truth {
        background: #feebc8;
        color: #c05621;
      }
      .badge-dare {
        background: #fed7e2;
        color: #97266d;
      }
      .btn-reset {
        background: #4a5568;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: bold;
        cursor: pointer;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <!-- Canvas untuk Efek Animasi Background -->
    <canvas id="bg-canvas"></canvas>

    <div class="card">
      <h1>💖 Truth or Dare: Couple Edition</h1>
      <p class="subtitle">Khusus buat kamu dan doi tercinta</p>

      <div class="mode-selection">
        <button class="btn-mode btn-truth" onclick="getTruth()">
          TRUTH (Jujur) 🤭
        </button>
        <button class="btn-mode btn-dare" onclick="getDare()">
          DARE (Tantangan) 💕
        </button>
      </div>

      <div class="card-content" id="display-box">
        <span class="badge badge-truth" id="card-badge">SIAP BERMAIN</span>
        <h3 id="card-text">
          Pilih Truth untuk kejujuran atau Dare untuk tantangan romantis! 👇
        </h3>
      </div>

      <button class="btn-reset" onclick="resetGame()">Reset 🔄</button>
    </div>

    <script>
      // --- ANIMASI BACKGROUND HATI (CANVAS) ---
      const bgCanvas = document.getElementById("bg-canvas");
      const bgCtx = bgCanvas.getContext("2d");

      function resizeCanvas() {
        bgCanvas.width = window.innerWidth;
        bgCanvas.height = window.innerHeight;
      }
      window.addEventListener("resize", resizeCanvas);
      resizeCanvas();

      const hearts = [];
      const numHearts = 35;

      class Heart {
        constructor() {
          this.reset();
        }

        reset() {
          this.x = Math.random() * bgCanvas.width;
          this.y = bgCanvas.height + Math.random() * 100;
          this.size = Math.random() * 15 + 10;
          this.speedY = Math.random() * 1.5 + 0.5;
          this.speedX = Math.sin(Math.random() * Math.PI * 2) * 0.5;
          this.opacity = Math.random() * 0.5 + 0.3;
          this.swing = Math.random() * 0.05 + 0.01;
          this.angle = Math.random() * Math.PI * 2;
        }

        update() {
          this.y -= this.speedY;
          this.angle += this.swing;
          this.x += Math.sin(this.angle) * 0.8;

          if (this.y < -30) {
            this.reset();
          }
        }

        draw() {
          bgCtx.save();
          bgCtx.globalAlpha = this.opacity;
          bgCtx.fillStyle = "#ffffff";
          bgCtx.font = `${this.size}px serif`;
          bgCtx.fillText("❤️", this.x, this.y);
          bgCtx.restore();
        }
      }

      for (let i = 0; i < numHearts; i++) {
        const h = new Heart();
        h.y = Math.random() * bgCanvas.height; // Menyebar di awal
        hearts.push(h);
      }

      function animateBG() {
        bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
        hearts.forEach((heart) => {
          heart.update();
          heart.draw();
        });
        requestAnimationFrame(animateBG);
      }
      animateBG();

      // --- SCRIPT TRUTH OR DARE ---
      const truths = [
        "Kapan pertama kalinya kamu benar-benar merasa jatuh cinta sama aku?",
        "Apa hal kecil yang aku lakuin tapi diam-diam paling kamu suka?",
        "Pernah gak kamu mimpiin aku? Mimpi seperti apa?",
        "Apa kebiasaan aku yang kadang bikin kamu kesel tapi sebenarnya kamu gemes?",
        "Kalau lagi berjauhan, bagian mana dari aku yang paling bikin kangen?",
        "Jujur, apa hal pertama yang kamu perhatiin dari aku pas pertama kali ketemu?",
        "Sebutkan satu hal rahasia yang belum pernah kamu berani bilang ke aku.",
        "Lagu apa yang kalau kamu dengar sekarang, langsung bikin kamu ingat ke aku?",
        "Siapa nama mantan yang paling bikin kamu susah move on sebelum ketemu aku?",
        "Pernah gak kamu cemburu sama temen aku? Siapa orangnya?",
        "Apa ketakutan terbesar kamu tentang hubungan kita ke depannya?",
        "Kalau aku tiba-tiba hilang kabar seharian, apa pikiran pertama yang muncul di kepala kamu?",
        "Sebutkan 1 sifat aku yang paling ingin kamu ubah kalau bisa!",
        "Pernah gak kamu ngerasa ilfiel sama aku karena hal sepele? Momen apa itu?",
        "Foto aku yang mana yang menurut kamu paling cantik / ganteng banget?",
        "Apa momen paling bikin kamu deg-degan parah pas lagi sama aku?",
        "Jujur, siapa yang paling sering kangen duluan kalau lagi LDR atau berantem?",
        "Pernah gak kamu diem-diem ngeliatin foto masa kecil aku?",
        "Apa hal terbodoh yang pernah kamu lakuin gara-gara lagi jatuh cinta?",
        "Menurut kamu, siapa di antara kita berdua yang paling keras kepala?",
        "Pernah gak kamu bohong kecil ke aku demi kebaikan? Soal apa tuh?",
        "Apa pujian dari aku yang paling nempel di kepala kamu sampai sekarang?",
        "Kalau kita jalan berdua, siapa yang paling boros belanja atau makan?",
        "Apa mimpi atau cita-cita masa depan kamu yang paling ingin kita capai bareng?",
      ];

      const dares = [
        "Kirimkan voice note sekarang juga berisi pujian manis buat aku selama 30 detik.",
        "Pegang tangan aku (atau tatap mata aku) sambil bilang 3 hal yang paling kamu syukuri dari aku.",
        "Ganti nama kontak aku di HP kamu pakai panggilan paling sayang/alay selama seminggu.",
        "Ceritakan kembali momen paling berkesan saat kita jalan bareng lewat sudut pandang kamu.",
        "Bikin gombalan dadakan sekarang juga, dan aku yang nilai jelek/bagusnya!",
        "Kirim foto selfie kamu pasang muka paling cemberut/lucu ke chat aku.",
        "Suruh aku dengerin lagu romantis pilihan kamu, terus kita dengerin bareng.",
        "Berikan pelukan hangat (atau genggaman tangan erat) selama 1 menit penuh tanpa ngomong apa-apa.",
        "Sun / cium pipi aku 5x sekarang juga!",
        "Tatap mata aku selama 10 detik tanpa kedip terus bilang 'I love you'!",
        "Ganti wallpaper chat WhatsApp kamu pakai foto muka kocak aku selama 3 hari.",
        "Traktir aku makanan atau minuman kesukaan aku hari ini / kencan berikutnya!",
        "Pukpuk kepala aku sambil bilang 'Kamu udah berusaha keras hari ini, semangat ya!'.",
        "Kirim chat ke salah satu temen dekat kamu: 'Aku bersyukur banget punya pacar kayak [Nama Kamu]'.",
        "Peragakan cara aku kalau lagi ngambek atau marah sampai aku ketawa!",
        "Izinkan aku scroll dan baca 3 chat terakhir di WhatsApp kamu tanpa protes!",
        "Pijat pundak aku selama 2 menit penuh sambil dengerin keluh kesah hari ini.",
        "Pilih salah satu filter kamera lucu di HP kamu, terus kita foto bareng sekarang.",
        "Bacakan pesan chat pertama kita waktu awal-awal kenal dulu dengan nada dramatis.",
        "Bikin video pendek berdurasi 10 detik bilang 'Aku bucin banget sama kamu' buat disimpan di galeri.",
        "Gendong aku (atau gandeng tangan erat-erat keliling ruangan) sambil nyanyi lagu romantis.",
        "Kasih aku satu hal yang ada di kantong atau dompet kamu sekarang sebagai 'tanda cinta'.",
        "Tulis pesan cinta singkat di selembar kertas/notes, lalu tempel di layar HP aku.",
      ];

      const cardBadge = document.getElementById("card-badge");
      const cardText = document.getElementById("card-text");

      function getTruth() {
        const randomTruth = truths[Math.floor(Math.random() * truths.length)];
        cardBadge.className = "badge badge-truth";
        cardBadge.innerText = "TRUTH (PERTANYAAN PASANGAN)";
        cardText.innerText = randomTruth;
      }

      function getDare() {
        const randomDare = dares[Math.floor(Math.random() * dares.length)];
        cardBadge.className = "badge badge-dare";
        cardBadge.innerText = "DARE (TANTANGAN ROMANTIS)";
        cardText.innerText = randomDare;
      }

      function resetGame() {
        cardBadge.className = "badge badge-truth";
        cardBadge.innerText = "SIAP BERMAIN";
        cardText.innerText =
          "Pilih Truth untuk kejujuran atau Dare untuk tantangan romantis! 👇";
      }
    </script>
  </body>
</html>
